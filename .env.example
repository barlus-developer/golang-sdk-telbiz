# Copy into your local environment; the SDK does not load .env files.
# Keep credentials on your backend. Never commit populated credentials.
TELBIZ_CLIENT_ID=
TELBIZ_CLIENT_SECRET=

# Explicitly running SMS/top-up examples is billable.
# Phone format is 20 followed by eight ASCII digits (example: 2012345678).
TELBIZ_PHONE=
TELBIZ_MESSAGE=
TELBIZ_AMOUNT=
